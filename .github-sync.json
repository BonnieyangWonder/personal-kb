{
  "version": 1,
  "remote": "https://github.com/BonnieyangWonder/personal-kb.git",
  "branch": "main",
  "sync": {
    "autoIntervalMin": 30,
    "ignorePatterns": [
      ".DS_Store",
      ".obsidian/workspace.json",
      ".obsidian/workspace-mobile.json",
      ".obsidian/plugins/**",
      ".obsidian/themes/**",
      ".trash/**",
      ".obsidian/**"
    ]
  },
  "ai": {
    "enabled": true,
    "silentMode": true,
    "silentMinConfidence": 3,
    "openaiModel": "gpt-5.5",
    "geminiModel": "gemini-2.5-flash",
    "claudeModel": "claude-sonnet-4-5",
    "deepseekModel": "deepseek-chat",
    "sendFilePaths": true,
    "sendGitMetadata": true,
    "sendSurroundingContext": true,
    "excludePatterns": [
      ".env",
      ".env.*",
      "secrets/**",
      "*.private.md",
      "private/**",
      "**/credentials.*"
    ]
  },
  "submodules": [
    {
      "path": "Z01-Resource/CB-business",
      "remote": "https://github.com/chancetop-com/Cookbook-Business-KB.git",
      "branch": "main"
    },
    {
      "path": "Z01-Resource/CB-bigquery",
      "remote": "https://github.com/chancetop-com/Cookbook-Bigquery-KB.git",
      "branch": "bonnie",
      "upstreamBranch": "main"
    }
  ]
}
